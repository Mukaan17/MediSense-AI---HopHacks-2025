# MediSense AI environment template.
# Copy to .env and fill in the secrets. Every variable here is read by the code;
# see docs/MASTER_PLAN.md for the audit that produced this list.

# --- Application mode ---
# demo     : showcases every feature on the bundled synthetic dataset (no auth)
# clinical : mocked features disabled, authentication required
APP_MODE=demo

# --- LLM: Claude (primary, optional) ---
# When ANTHROPIC_API_KEY is set, live coaching streams from Claude and the deep
# final report uses the configured final-report model (config/models.yaml).
ANTHROPIC_API_KEY=
# Optional overrides for config/models.yaml routing:
# LIVE_MODEL=claude-haiku-4-5
# FINAL_MODEL=claude-sonnet-4-6

# --- LLM: Gemini (fallback / default) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=4096

# --- Imaging ---
CXR_CKPT=checkpoints/biovil_vit_chexpert.pt
CXR_DEVICE=cpu
CXR_TOPK=6
FUSION_BACKEND=python

# --- EHR ---
EHR_JSON=ehr_with_images.json
# Set to 1 to skip sha256 hashing of EHR-linked images at startup (faster boot;
# image-hash EHR matching disabled). Default is 1; requires local chexpert/ files
# to be useful when 0.
SKIP_HASH=1

# --- RAG ---
RAG_PERSIST_DIR=./rag_store
RAG_COLLECTION=conversations
RAG_EMB_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
MAX_CTX_CHARS=2000

# --- Extraction / coaching thresholds ---
EXTRACTOR_USE_LLM=false
ASK_THRESH=0.70
MARGIN_THRESH=0.08

# --- CORS ---
# Comma-separated origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Voice ---
# Required only for pyannote speaker diarization on uploaded audio.
HUGGINGFACE_HUB_TOKEN=

# --- Auth (clinical mode) ---
# Secret for signing session JWTs. Generate one with: openssl rand -hex 32
# Every secret here can also come from AWS Secrets Manager or a file -
# see "Secrets resolution" below.
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_MINUTES=480
# Session cookies carry the Secure attribute by default; set to false ONLY
# for plain-http local test rigs.
# AUTH_COOKIE_SECURE=true

# --- Auth: OIDC SSO (optional, clinical mode) ---
# AUTH_MODE=oidc switches login to the hospital IdP (authorization code +
# PKCE; see core/oidc.py). Unset = password login against the users file.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://idp.example.org/realms/hospital
# OIDC_CLIENT_ID=medisense
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://app.example.org/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_ROLE_CLAIM=roles
# OIDC_ADMIN_ROLES=medisense-admin

# --- State ---
# Optional Redis URL for shared live-case state across workers/tasks.
# Falls back to in-process memory when unset.
# REDIS_URL=redis://localhost:6379/0
# Live cases expire after this TTL (seconds).
# CASE_TTL_SECONDS=3600

# --- Durable case store (optional) ---
# When set, cases persist an append-only event timeline + reports and the
# history endpoints (/api/cases, /api/case/{id}/timeline) come alive.
# This stores clinical content - read docs/COMPLIANCE.md first.
# CASE_DB_URL=postgresql+psycopg2://medisense:medisense@localhost:5432/medisense
# CASE_RETENTION_DAYS=90

# --- Finalize job queue (optional) ---
# queue: final reports are generated by the arq worker (requires REDIS_URL
# and a running worker); inline (default): generated in-request.
# FINALIZE_MODE=inline
# Live STT worker pool size (concurrent /ws/transcribe sessions).
# STT_WORKERS=1

# --- EHR source (clinical mode) ---
# file (default): EHR_JSON above. fhir: SMART-on-FHIR R4 server with
# Backend Services auth (core/fhir/).
# EHR_SOURCE=file
# FHIR_BASE_URL=https://fhir.example.org/R4
# FHIR_TOKEN_URL=https://fhir.example.org/oauth2/token
# FHIR_CLIENT_ID=medisense-backend
# FHIR_PRIVATE_KEY_PATH=/run/secrets/fhir_key.pem
# FHIR_SCOPES defaults to the full read roster (Patient, Observation,
# Condition, MedicationRequest, AllergyIntolerance) + DocumentReference.c
# for report write-back; override only to narrow it.
# FHIR_SCOPES=
# FHIR_PATIENT_IDS=

# --- Observability (optional) ---
# Sentry activates only when a DSN is set; PII capture stays off.
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_TRACES_RATE=0.0

# --- Secrets resolution ---
# Any secret-like variable resolves via: AWS Secrets Manager (when
# SECRETS_BACKEND=aws, id = SECRETS_PREFIX + name) -> plain env var ->
# <NAME>_FILE pointing at a file (docker/k8s secrets convention).
# SECRETS_BACKEND=
# SECRETS_PREFIX=medisense/
# AWS_REGION=us-east-1

# --- Logging ---
LOGLEVEL=INFO
