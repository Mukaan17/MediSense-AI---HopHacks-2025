# CPU-only backend image: the default for laptops, demos, and any deployment
# without a GPU. The CUDA image (Dockerfile) remains for GPU imaging capacity.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HUGGINGFACE_HUB_CACHE=/app/cache/huggingface \
    TORCH_HOME=/app/cache/torch

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU torch first (smaller wheel index), then the rest without the pinned
# torch stack.
COPY requirements.txt .
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && awk '!/^torch/' requirements.txt > /tmp/reqs.txt \
    && pip install --no-cache-dir -r /tmp/reqs.txt

COPY . .

# Build the knowledge base at container start when absent (the store also
# persists across restarts via the rag_store volume), then serve.
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s \
    CMD curl -sf http://localhost:8000/health || exit 1

CMD ["/entrypoint.sh"]
